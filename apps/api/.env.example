# Neon Postgres connection string (pooled), used by Prisma once persistence work begins.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

NODE_ENV="development"
PORT=4000
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# Optional newsletter provider integration
RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""
RESEND_FROM_EMAIL="JUSTBUY <orders@yourexample.com>"
ADMIN_NOTIFICATION_EMAIL="your-email@provider.com"

# Paystack payment integration
PAYMENT_PROVIDER="paystack"
PAYMENT_PROVIDER_SECRET_KEY=""
PAYMENT_CALLBACK_URL="http://localhost:5173/payment/verify"
PAYSTACK_SECRET_KEY=""
PAYSTACK_CALLBACK_URL="http://localhost:5173/payment/verify"

# Optional infrastructure
# CLOUDINARY_URL=
# REDIS_URL=
